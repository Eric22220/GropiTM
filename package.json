    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.30"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "^6.2.8",
