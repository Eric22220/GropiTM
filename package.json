  "description": "ShockGrid (GropiTM) — harta confortului velo din Timișoara, din vibrații măsurate cu telefonul pe ghidon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
